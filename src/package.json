{
	"name": "game",
	"version": "1.0.0",
	"description": "",
	"main": "dist/index.html",
	"targets": {
		"main": false
	},
	"window": {
		"title": "Excalibur NW.js",
		"icon": "./favicon.png",
		"toolbar": true,
		"frame": true,
		"width": 800,
		"height": 500,
		"position": "center",
		"min_width": 400,
		"min_height": 200,
		"max_width": 800,
		"max_height": 600
	},
	"nwbuild": {
		"mode": "build",
		"glob": false,
		"version": "latest",
		"flavor": "normal",
		"cacheDir": "./node_modules/nw",
		"outDir": "../out",
		"logLevel": "debug",
		"app": {
			"name": "Demo",
			"version": "0.0.0",
			"comments": "Diagnostic information",
			"company": "NW.js Utilities",
			"fileDescription": "This is a demo app to test nw-builder functionality",
			"fileVersion": "0.0.0",
			"internalName": "Demo",
			"legalCopyright": "Copyright (c) 2024 NW.js Utilities",
			"originalFilename": "Demo",
			"productName": "Demo",
			"productVersion": "0.0.0"
		}
	},
	"webkit": {
		"plugin": true
	},
	"scripts": {
		"start": "parcel serve index.html",
		"build": "parcel build index.html --public-url ./",
		"build:nw": "nwbuild ./*"
	},
	"dependencies": {
		"excalibur": "0.30.0-alpha.1267"
	},
	"devDependencies": {
		"typescript": "5.7.2",
		"parcel": "2.13.2"
	}
}
